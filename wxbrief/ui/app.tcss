/* Layout and chrome use Textual's theme variables. The weather colours ($wx-*, $fcat-*, $cs-*) are at the end. */

BriefingScreen #main {
    height: 1fr;
}

StationList {
    width: 38;
    border-right: tall $primary-background-lighten-2;
    background: $surface;
}

StationList:focus {
    border-right: tall $primary;
}

DetailPane {
    width: 1fr;
    padding: 0 1;
    background: $surface;
}

DetailPane .section {
    margin-top: 1;
    color: $text-muted;
    text-style: bold;
}

DetailPane #placeholder {
    margin: 2 2;
    color: $text-muted;
}

StationHeader {
    height: auto;
    padding-top: 1;
}

FlagsRow {
    height: auto;
    margin-top: 1;
}

RawReport {
    height: auto;
}

DecodedTable {
    height: auto;
    background: $surface;
}

DecodedTable > .datatable--header {
    display: none;
}

#remarks-box {
    margin-top: 1;
    padding: 0;
    background: $surface;
    border: none;
}

#taf {
    height: auto;
}

#warnings {
    margin-top: 1;
    height: auto;
}

StatusBar {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* Narrow terminals: the list gives way to the detail; [ and ] or j and k change station. */
BriefingScreen.-narrow StationList {
    display: none;
}

BriefingScreen.-narrow DetailPane {
    padding: 0;
}

.dialog {
    width: 80%;
    max-width: 90;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    border: round $primary;
    background: $surface;
}

.dialog-title {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}

.hint {
    color: $text-muted;
    margin-top: 1;
}

AddStationScreen, HelpScreen, SettingsScreen {
    align: center middle;
    background: $background 60%;
}

#add-box #results {
    height: auto;
    max-height: 12;
    margin-top: 1;
    border: none;
    background: $surface;
}

PasteDecodeScreen #paste-layout {
    height: 1fr;
}

PasteDecodeScreen #paste-reference {
    height: 1;
    padding: 0 1;
}

PasteDecodeScreen #paste-reference Label {
    margin-right: 1;
}

PasteDecodeScreen #reference {
    width: 14;
}

PasteDecodeScreen #paste-input {
    height: 35%;
    min-height: 4;
}

PasteDecodeScreen #paste-output {
    height: 1fr;
    padding: 0 1;
    border-top: tall $primary-background-lighten-2;
}

PasteDecodeScreen #paste-result {
    height: auto;
}

/* --- Colourways (theme) ------------------------------------------------------------------------------------------
   The picker sits to the right so the UI behind it, which previews the highlighted theme, stays visible.
   $fcat-* and $cs-* are fixed-meaning colours injected by WxBriefApp.get_css_variables(); "color: auto" picks black or
   white text, whichever reads better on the fill. */

/* A highlighted station is a tint of the theme's primary colour, so the coloured marks and badges stay readable. */
StationList > .option-list--option-highlighted {
    background: $primary 18%;
    color: $text;
    text-style: bold;
}

StationList:focus > .option-list--option-highlighted {
    background: $primary 30%;
}

ThemePickerScreen {
    align: right middle;
    background: $background 0%;
}

ThemePickerScreen .dialog {
    width: 34;
    margin-right: 2;
}

#theme-list {
    height: auto;
    max-height: 20;
    border: none;
    background: $surface;
}

.fcat-vfr { background: $fcat-vfr; color: auto; }
.fcat-mvfr { background: $fcat-mvfr; color: auto; }
.fcat-ifr { background: $fcat-ifr; color: auto; }
.fcat-lifr { background: $fcat-lifr; color: auto; }

.cs-blu { background: $cs-blu; color: auto; }
.cs-wht { background: $cs-wht; color: auto; }
.cs-grn { background: $cs-grn; color: auto; }
.cs-ylo { background: $cs-ylo; color: auto; }
.cs-amb { background: $cs-amb; color: auto; }
.cs-red { background: $cs-red; color: auto; }

/* === S6: TAF timeline, period detail, station grid and cards (forecast widgets) ================================== */

#taf-summary {
    height: auto;
}

#taf-note {
    height: auto;
}

TafTimeline {
    height: 5;
    margin-top: 1;
}

TafTimeline:focus {
    background: $boost;
}

PeriodDetail {
    height: auto;
    margin-top: 1;
}

#taf-groups-box {
    margin-top: 1;
    padding: 0;
    background: $surface;
    border: none;
}

#taf-groups {
    height: auto;
}

StationGrid {
    display: none;
    width: 1fr;
    padding: 0 1;
    background: $surface;
}

BriefingScreen.-grid StationGrid {
    display: block;
}

BriefingScreen.-grid StationList,
BriefingScreen.-grid DetailPane {
    display: none;
}

StationGrid #cards {
    layout: grid;
    grid-size: 2;
    grid-gutter: 0 1;
    height: auto;
}

StationCard {
    height: 6;
    padding: 0 1;
    border: round $primary-background-lighten-2;
    background: $surface;
}

StationCard.-selected {
    border: round $primary;
}

StationGrid:focus StationCard.-selected {
    border: heavy $primary;
}

StationDetailScreen DetailPane {
    height: 1fr;
}
/* === end S6 ===================================================================================================== */

/* === S8: scrollbars in theme colours; the track blends into the surface and a bar only shows when content overflows === */
* {
    scrollbar-background: $surface;
    scrollbar-background-hover: $surface;
    scrollbar-background-active: $surface;
    scrollbar-color: $primary-background-lighten-2;
    scrollbar-color-hover: $primary;
    scrollbar-color-active: $primary;
    scrollbar-corner-color: $surface;
}
/* Short terminals (under 24 rows): the detail pane gives up its spacing rows. */
BriefingScreen.-short StationHeader {
    padding-top: 0;
}

BriefingScreen.-short FlagsRow,
BriefingScreen.-short DetailPane .section {
    margin-top: 0;
}
/* === end S8 === */
